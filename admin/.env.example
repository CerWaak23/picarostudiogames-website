# Copia a .env.local (local) o a las variables de entorno de Vercel. NUNCA lo subas a git.

# Auth.js: genera uno con:  npx auth secret   (o  openssl rand -base64 32)
AUTH_SECRET=
# Credencial OAuth de Google (tipo "Aplicación web"). Redirección:
#   http://localhost:3100/api/auth/callback/google
#   https://admin.picarogamestudio.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Un par por juego (el nombre lo define credsEnv en projects/<juego>.ts).
# Service account de Unity "fitnessera-admin": Key ID y Secret.
UGS_FITNESSERA_KEY=
UGS_FITNESSERA_SECRET=
