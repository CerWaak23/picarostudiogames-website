# Copia a .env.local (local) o a las variables de entorno de Vercel. NUNCA lo subas a git.
# Solo las necesita el servidor: el formulario de la lista de espera del playtesting
# (app/api/playtesting/route.ts). Sin ellas el formulario responde "no se pudo guardar".

# Unity Dashboard → Fitness Era → Project Settings. No son secretos; son los mismos del panel.
UGS_FITNESSERA_PROJECT_ID=
UGS_FITNESSERA_ENV_ID=

# Service account "fitnessera-web" (Unity Cloud → Administration → Service Accounts).
# APARTE del que usa el panel: este solo necesita poder ejecutar Cloud Code.
UGS_FITNESSERA_WEB_KEY=
UGS_FITNESSERA_WEB_SECRET=
